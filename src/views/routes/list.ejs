<%- include('../partials/header') %>

    <h1><%- title %></h1>

    <div id="filters">
        <div class="trip-filter-control">
            <label for="trip-search">Search trips:</label>
            <input
                id="trip-search"
                type="search"
                maxlength="100"
                placeholder="Search name or description"
            >
        </div>

        <div class="trip-filter-control">
            <label for="region-filter">Region:</label>
            <select id="region-filter" data-client-managed="true">
                <option value="">All Regions</option>
            </select>
        </div>

        <div class="trip-filter-control">
            <label for="season-filter">Season:</label>
            <select id="season-filter" data-client-managed="true">
                <option value="">Any Season</option>
            </select>
        </div>

        <p class="filters-note">Search and filters apply to all available trips.</p>
    </div>

    <p id="trip-status" aria-live="polite">Loading trips...</p>

    <div class="routes-grid" id="trips-list"></div>

    <nav class="trip-pagination" aria-label="Trip list pages">
        <button id="previous-page" type="button" disabled>Previous</button>
        <span id="trip-page-status" aria-live="polite"></span>
        <button id="next-page" type="button" disabled>Next</button>
    </nav>

    <template id="trip-card-template">
        <div class="route-card">
            <div class="route-header">
                <h2 class="route-name"></h2>
                <span class="route-region"></span>
            </div>

            <div class="station-info">
                <div class="station">
                    <div class="station-type">From:</div>
                    <div class="station-name trip-start-station"></div>
                </div>
                <div class="route-arrow">&#8594;</div>
                <div class="station">
                    <div class="station-type">To:</div>
                    <div class="station-name trip-end-station"></div>
                </div>
            </div>

            <div class="route-details">
                <div class="detail-item">
                    <span class="detail-icon">&#128337;</span>
                    <span><span class="detail-label">Duration:</span> <span class="trip-duration"></span></span>
                </div>
                <div class="detail-item">
                    <span class="detail-icon">&#128205;</span>
                    <span><span class="detail-label">Distance:</span> <span class="trip-distance"></span>km</span>
                </div>
                <div class="detail-item">
                    <span class="season-badge trip-season"></span>
                </div>
            </div>

            <div class="route-description trip-description"></div>

            <div class="highlights">
                <div class="highlights-list trip-highlights"></div>
            </div>

            <div class="route-actions">
                <a class="view-details-btn">
                    View Details &amp; Book &#8594;
                </a>
            </div>
        </div>
    </template>

    <script>
        const tripsList = document.querySelector("#trips-list");
        const tripTemplate = document.querySelector("#trip-card-template");
        const tripStatus = document.querySelector("#trip-status");
        const pageStatus = document.querySelector("#trip-page-status");
        const previousPageButton = document.querySelector("#previous-page");
        const nextPageButton = document.querySelector("#next-page");
        const searchInput = document.querySelector("#trip-search");
        const regionFilter = document.querySelector("#region-filter");
        const seasonFilter = document.querySelector("#season-filter");

        const initialUrl = new URL(window.location.href);
        const requestedPage = initialUrl.searchParams.get("page");
        const parsedInitialPage = Number(requestedPage);
        const initialPage = /^\d+$/.test(requestedPage || "")
            && Number.isSafeInteger(parsedInitialPage)
            && parsedInitialPage > 0
            ? parsedInitialPage
            : 1;

        let currentPage = initialPage;
        let currentMeta = null;
        let latestRequestId = 0;
        let searchTimer;
        let currentFilters = {
            search: initialUrl.searchParams.get("search") || "",
            region: initialUrl.searchParams.get("region") || "",
            season: initialUrl.searchParams.get("season") || "",
        };

        searchInput.value = currentFilters.search;

        function formatFilterLabel(value) {
            return value.charAt(0).toUpperCase() + value.slice(1);
        }

        function populateFilterOptions(select, values, allLabel, selectedValue) {
            select.replaceChildren(new Option(allLabel, ""));

            values.forEach((value) => {
                select.append(new Option(formatFilterLabel(value), value));
            });

            select.value = selectedValue || "";
        }

        function renderTrips(trips) {
            const fragment = document.createDocumentFragment();

            trips.forEach((trip) => {
                const tripCard = tripTemplate.content.cloneNode(true);
                const card = tripCard.querySelector(".route-card");

                card.classList.add(trip.region);
                tripCard.querySelector(".route-name").textContent = trip.name;
                tripCard.querySelector(".route-region").textContent = trip.region;
                tripCard.querySelector(".trip-start-station").textContent = trip.startStation;
                tripCard.querySelector(".trip-end-station").textContent = trip.endStation;
                tripCard.querySelector(".trip-duration").textContent = trip.duration;
                tripCard.querySelector(".trip-distance").textContent = trip.distance;
                tripCard.querySelector(".trip-description").textContent = trip.description;

                const seasonBadge = tripCard.querySelector(".trip-season");
                seasonBadge.textContent = `Best in ${trip.bestSeason}`;
                seasonBadge.classList.add(`season-${trip.bestSeason}`);

                const highlightsList = tripCard.querySelector(".trip-highlights");

                trip.highlights.forEach((highlight) => {
                    const tag = document.createElement("span");
                    tag.className = "highlight-tag";
                    tag.textContent = highlight;
                    highlightsList.append(tag);
                });

                const detailsLink = tripCard.querySelector(".view-details-btn");
                detailsLink.href = `/routes/${trip.id}`;

                fragment.append(tripCard);
            });

            tripsList.replaceChildren(fragment);
        }

        function buildApiUrl(page) {
            const parameters = new URLSearchParams({ page: String(page) });

            if (currentFilters.region) {
                parameters.set("region", currentFilters.region);
            }

            if (currentFilters.season) {
                parameters.set("season", currentFilters.season);
            }

            if (currentFilters.search.trim()) {
                parameters.set("search", currentFilters.search);
            }

            return `/api/trips?${parameters.toString()}`;
        }

        function setOrDeleteParameter(url, name, value) {
            if (value) {
                url.searchParams.set(name, value);
            } else {
                url.searchParams.delete(name);
            }
        }

        function updateBrowserUrl(page) {
            const url = new URL(window.location.href);

            if (page === 1) {
                url.searchParams.delete("page");
            } else {
                url.searchParams.set("page", page);
            }

            setOrDeleteParameter(url, "region", currentFilters.region);
            setOrDeleteParameter(url, "season", currentFilters.season);
            setOrDeleteParameter(url, "search", currentFilters.search);

            window.history.replaceState({}, "", url);
        }

        function updatePagination(meta) {
            currentPage = meta.page;
            currentMeta = meta;
            currentFilters = {
                search: meta.filters.search || "",
                region: meta.filters.region || "",
                season: meta.filters.season || "",
            };

            searchInput.value = currentFilters.search;
            populateFilterOptions(
                regionFilter,
                meta.availableFilters.regions,
                "All Regions",
                currentFilters.region
            );
            populateFilterOptions(
                seasonFilter,
                meta.availableFilters.seasons,
                "Any Season",
                currentFilters.season
            );

            previousPageButton.disabled = !meta.hasPreviousPage;
            nextPageButton.disabled = !meta.hasNextPage;
            pageStatus.textContent = meta.totalPages
                ? `Page ${meta.page} of ${meta.totalPages}`
                : "No pages available";
            updateBrowserUrl(meta.page);
        }

        async function loadTrips(page = 1) {
            const requestId = ++latestRequestId;
            tripStatus.textContent = "Loading trips...";
            previousPageButton.disabled = true;
            nextPageButton.disabled = true;

            try {
                const response = await fetch(buildApiUrl(page));
                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    const details = Array.isArray(data.details)
                        ? data.details.map((detail) => detail.message).join(" ")
                        : "";
                    throw new Error(details || data.error || "Unable to load trips.");
                }

                if (
                    !Array.isArray(data.results)
                    || !data.meta?.filters
                    || !Array.isArray(data.meta?.availableFilters?.regions)
                    || !Array.isArray(data.meta?.availableFilters?.seasons)
                ) {
                    throw new Error("Invalid trips response.");
                }

                if (requestId !== latestRequestId) {
                    return;
                }

                renderTrips(data.results);
                updatePagination(data.meta);

                if (data.results.length) {
                    const firstItem = (data.meta.page - 1) * data.meta.perPage + 1;
                    const lastItem = firstItem + data.results.length - 1;
                    tripStatus.textContent = `Showing trips ${firstItem}-${lastItem} of ${data.meta.totalItems}.`;
                } else if (data.meta.totalItems === 0) {
                    const hasFilters = Object.values(data.meta.filters).some(Boolean);
                    tripStatus.textContent = hasFilters
                        ? "No trips match your search and filters."
                        : "No trips are available.";
                } else {
                    tripStatus.textContent = "No trips were found on this page.";
                }
            } catch (error) {
                if (requestId !== latestRequestId) {
                    return;
                }

                tripsList.replaceChildren();
                tripStatus.textContent = error.message || "Unable to load trips. Please try again later.";
                pageStatus.textContent = "";
                currentMeta = null;
                console.error(error);
            }
        }

        previousPageButton.addEventListener("click", () => {
            if (currentMeta?.hasPreviousPage) {
                loadTrips(currentPage - 1);
            }
        });

        nextPageButton.addEventListener("click", () => {
            if (currentMeta?.hasNextPage) {
                loadTrips(currentPage + 1);
            }
        });

        regionFilter.addEventListener("change", () => {
            currentFilters.region = regionFilter.value;
            loadTrips(1);
        });

        seasonFilter.addEventListener("change", () => {
            currentFilters.season = seasonFilter.value;
            loadTrips(1);
        });

        searchInput.addEventListener("input", () => {
            currentFilters.search = searchInput.value;
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(() => loadTrips(1), 300);
        });

        loadTrips(initialPage);
    </script>

    <%- include('../partials/footer') %>

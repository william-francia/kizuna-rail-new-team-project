<%- include('../partials/header') %>

<style>
  /* Styles for station info button & icon */
  .station-info-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    margin-left: 6px;
    vertical-align: middle;
    transition: transform 0.2s ease;
  }
  .station-info-btn:hover {
    transform: scale(1.2);
  }

  /* Styles for Modal Pop-up */
  .station-modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
  }

  .station-modal-content {
    background-color: #ffffff;
    color: #333333;
    padding: 24px;
    border-radius: 8px;
    max-width: 480px;
    width: 90%;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    position: relative;
  }

  .close-modal-btn {
    position: absolute;
    top: 12px;
    right: 16px;
    font-size: 1.5rem;
    cursor: pointer;
    border: none;
    background: none;
    color: #666;
  }

  .close-modal-btn:hover {
    color: #000;
  }

  .loading-spinner {
    text-align: center;
    font-style: italic;
    color: #666;
    margin: 20px 0;
  }
</style>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= details.name %></h1>
            <p class="route-description"><%= details.description %></p>
            
            <% if (details.highlights && details.highlights.length > 0) { %>
            <div class="highlights">
                <% details.highlights.forEach(function(highlight) { %>
                <span class="highlight-tag"><%= highlight %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <% if (details.imageUrl) { %>
        <div class="route-image">
            <img src="<%= details.imageUrl %>" alt="<%= details.name %>">
        </div>
        <% } %>
    </div>

    <div class="route-info">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Region</span>
                <span class="info-value region-<%= details.region %>"><%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value"><%= details.duration %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value"><%= details.distance %> km</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Best Season</span>
                <span class="info-value season-<%= details.bestSeason %>"><%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %></span>
            </div>
        </div>

        <div class="route-stations">
            <h2>Route</h2>
            <div class="stations">
                <div class="station">
                    <span class="station-label">Start</span>
                    <span class="station-name"><%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %></span>
                    <!-- Button to trigger the startStation API call -->
                    <button type="button" class="station-info-btn" title="View Station Info" onclick="fetchStationDetails('<%= details.startStationId || details.startStation %>')">ℹ️</button>
                </div>
                <div class="station">
                    <span class="station-label">End</span>
                    <span class="station-name"><%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %></span>
                    <!-- Button to trigger the endStation API call -->
                    <button type="button" class="station-info-btn" title="View Station Info" onclick="fetchStationDetails('<%= details.endStationId || details.endStation %>')">ℹ️</button>
                </div>
            </div>
        </div>

        <div class="route-operating">
            <h2>Operating Schedule</h2>
            <div class="months-grid">
                <% details.operatingMonths.forEach(function(month) { %>
                <span class="month-badge"><%= month %></span>
                <% }); %>
            </div>
        </div>

        <% if (details.schedules && details.schedules.length > 0) { %>
        <div class="route-schedules">
            <h2>Available Schedules</h2>
            <div class="schedules-grid">
                <% details.schedules.forEach(function(schedule) { %>
                <div class="schedule-card">
                    <div class="schedule-times">
                        <div class="time-block">
                            <span class="time-label">Departs</span>
                            <span class="time-value"><%= schedule.departureTime %></span>
                        </div>
                        <span class="time-arrow">→</span>
                        <div class="time-block">
                            <span class="time-label">Arrives</span>
                            <span class="time-value"><%= schedule.arrivalTime %></span>
                        </div>
                    </div>
                    <div class="schedule-days">
                        <% schedule.daysOfWeek.forEach(function(day) { %>
                        <span class="day-badge"><%= day.substring(0, 3) %></span>
                        <% }); %>
                    </div>
                    <a href="/routes/booking/<%= schedule.id %>" class="book-btn">Book Now</a>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
</article>

<!-- Modal Pop-up to display station details -->
<div id="stationModal" class="station-modal">
  <div class="station-modal-content">
    <button class="close-modal-btn" onclick="closeStationModal()">&times;</button>
    <div id="stationModalDetails"></div>
  </div>
</div>

<script>
  async function fetchStationDetails(stationIdentifier) {
    const modal = document.getElementById('stationModal');
    const detailsContainer = document.getElementById('stationModalDetails');

    modal.style.display = 'flex';
  detailsContainer.textContent = '';
    try {
    const response = await fetch(`/api/stations/${stationIdentifier}`);
    
    if (!response.ok) {
      throw new Error('Failed to fetch station details');
    }

    const station = await response.json();
    detailsContainer.textContent = '';

    const title = document.createElement('h2');
    title.style.marginTop = '0';
    title.textContent = station.name || stationIdentifier;
    detailsContainer.appendChild(title);

    if (station.prefecture) {
      const p = document.createElement('p');
      p.innerHTML = '<strong>Prefecture:</strong> ';
      p.appendChild(document.createTextNode(station.prefecture));
      detailsContainer.appendChild(p);
    }

    if (station.region) {
      const p = document.createElement('p');
      p.innerHTML = '<strong>Region:</strong> ';
      p.appendChild(document.createTextNode(station.region));
      detailsContainer.appendChild(p);
    }

    if (station.description) {
      const p = document.createElement('p');
      p.innerHTML = '<strong>Description:</strong> ';
      p.appendChild(document.createTextNode(station.description));
      detailsContainer.appendChild(p);
    }

    if (station.facilities && station.facilities.length > 0) {
      const p = document.createElement('p');
      p.innerHTML = '<strong>Facilities:</strong>';
      detailsContainer.appendChild(p);

      const ul = document.createElement('ul');
      station.facilities.forEach(facility => {
        const li = document.createElement('li');
        li.textContent = facility;
        ul.appendChild(li);
      });
      detailsContainer.appendChild(ul);
    }

  } catch (error) {
    console.error('Error:', error);
    detailsContainer.textContent = '';
    const errorMsg = document.createElement('p');
    errorMsg.style.color = '#d9534f';
    errorMsg.textContent = 'Could not load station details.';
    detailsContainer.appendChild(errorMsg);
  }
}

  function closeStationModal() {
    document.getElementById('stationModal').style.display = 'none';
  }

  window.onclick = function(event) {
    const modal = document.getElementById('stationModal');
    if (event.target === modal) {
      modal.style.display = 'none';
    }
  };
</script>

<%- include('../partials/footer') %>
<%- include('partials/header') %>
<article class="bookings-admin-page">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= title %></h1>
            <p class="route-description">Every booking received, newest first.</p>
        </div>
    </div>

    <section class="bookings-admin">
        <p id="bookings-status" class="bookings-status" aria-live="polite">Loading bookings...</p>

        <div class="bookings-table-wrapper">
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th scope="col">Booking Reference</th>
                        <th scope="col">Route</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Ticket Class</th>
                        <th scope="col">Travel Day</th>
                        <th scope="col">Passengers</th>
                        <th scope="col">Passenger Names</th>
                        <th scope="col">Booked On</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody id="bookings-list"></tbody>
            </table>
        </div>
    </section>
</article>

<template id="booking-row-template">
    <tr>
        <td class="booking-code"></td>
        <td class="booking-route"></td>
        <td class="booking-schedule"></td>
        <td class="booking-ticket"></td>
        <td class="booking-day"></td>
        <td class="booking-passenger-count"></td>
        <td class="booking-passengers"></td>
        <td class="booking-created"></td>
        <td class="booking-actions">
            <button type="button" class="btn-edit">Edit</button>
            <button type="button" class="btn-delete">Delete</button>
        </td>
    </tr>
</template>

<style>
    .bookings-admin { padding: 1rem; }
    .bookings-status { margin-bottom: 1rem; }
    .bookings-table-wrapper { overflow-x: auto; }
    .bookings-table { width: 100%; border-collapse: collapse; }
    .bookings-table th,
    .bookings-table td {
        padding: 0.5rem 0.75rem;
        text-align: left;
        border-bottom: 1px solid rgba(128, 128, 128, 0.3);
    }
    .booking-actions button { margin-right: 0.5rem; }
</style>

<script src="/js/admin-bookings.js" defer></script>

<%- include('partials/footer') %>

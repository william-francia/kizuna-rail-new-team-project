<%- include('partials/header') %>

  <script>
    document.body.dataset.userRole = "<%= user?.role || '' %>";
    document.body.dataset.userId = "<%= user?.id || '' %>";
  </script>

  <article class="user-admin-page">
    <div class="route-header">
      <div class="route-header-content">
        <h1 class="route-name">
          <%= title %>
        </h1>
        <p class="route-description">Manage user information.</p>
      </div>
    </div>

    <section class="user-admin">
      <form id="user-filters" class="user-filters">
        <label>
          Search users
          <input id="user-keyword" type="search" name="keyword" placeholder="Name, username, or email"
            maxlength="100" />
        </label>

        <label>
          Role
          <select id="user-role-filter" name="role">
            <option value="">All roles</option>
            <option value="admin">Admin</option>
            <option value="customer">Customer</option>
          </select>
        </label>

        <div class="user-filter-actions">
          <button type="submit">Search</button>
          <button type="button" id="clear-user-filters">Clear</button>
        </div>
      </form>

      <p id="users-status" class="users-status" aria-live="polite">
        Loading users...
      </p>

      <div class="users-list" id="users-list"></div>

      <div id="users-pagination" class="users-pagination"></div>
    </section>
  </article>

  <template id="user-template">
    <article class="user-card">
      <h2 class="user-name"></h2>

      <form class="user-form">
        <label>
          Display Name
          <input class="user-display-name" type="text" name="displayName" required />
        </label>

        <label>
          Username
          <input class="user-username" type="text" name="username" required />
        </label>

        <label>
          Email
          <input class="user-email" type="email" name="email" required />
        </label>

        <% if (user?.role === "admin" ) { %>
          <label class="role-field">
            Role
            <select class="user-role" name="role">
              <option value="customer">Customer</option>
              <option value="admin">Admin</option>
            </select>
          </label>
          <% } %>

            <label>
              New Password
              <input class="user-password" type="password" name="password" />
            </label>

            <div class="user-actions">
              <button type="submit">Update</button>
              <button type="button" class="delete-user">Delete</button>
            </div>
      </form>
    </article>
  </template>

  <style>
    .user-admin {
      padding: 1rem;
    }

    .users-status {
      margin-bottom: 1rem;
    }

    .user-filters {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      border: 1px solid rgba(128, 128, 128, 0.3);
      border-radius: 8px;
    }

    .user-filters label {
      display: grid;
      gap: 0.35rem;
    }

    .user-filters input,
    .user-filters select {
      padding: 0.5rem;
    }

    .user-filter-actions {
      display: flex;
      gap: 0.75rem;
    }

    .user-filter-actions button {
      padding: 0.5rem 1rem;
    }

    .users-list {
      display: grid;
      gap: 1.5rem;
    }

    .user-card {
      padding: 1.5rem;
      border: 1px solid rgba(128, 128, 128, 0.3);
      border-radius: 8px;
    }

    .user-card h2 {
      margin-top: 0;
    }

    .user-form {
      display: grid;
      gap: 1rem;
    }

    .user-form label {
      display: grid;
      gap: 0.35rem;
    }

    .user-form input,
    .user-form select {
      padding: 0.5rem;
    }

    .user-actions {
      display: flex;
      gap: 0.75rem;
    }

    .user-actions button {
      padding: 0.5rem 1rem;
    }
  </style>

  <script src="/js/user-admin.js"></script>
  <%- include('partials/footer') %>
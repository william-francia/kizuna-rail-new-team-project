<%- include('../partials/header') %>

<article class="booking-page">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= title %></h1>
            <p class="route-description">Complete your booking details below.</p>
        </div>
    </div>

    <form class="booking-form" method="POST" action="/routes/book">
        <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
        <input type="hidden" name="routeId" value="<%= schedule.routeId %>">

        <input type="hidden" name="ticketClass" id="selectedTicketClass">
        <section class="ticket-selection">
            <h2 class="section-title">Select Your Ticket</h2>

            <div
                class="ticket-options"
                id="ticketOptions"
                aria-live="polite"
            >
                <p class="ticket-loading">Loading ticket classes...</p>
            </div>

            <div
                class="ticket-pagination"
                id="ticketPagination"
                aria-label="Ticket class pagination"
            >
            </div>
        </section>
        <section class="day-selection">
            <h2 class="section-title">Select The Day</h2>

            <div class="schedule-info">
                <div class="time-display">
                    <span class="departure-time"><%= schedule.departureTime %></span>
                    <span class="time-separator">→</span>
                    <span class="arrival-time"><%= schedule.arrivalTime %></span>
                </div>

                <div class="days-display">
                    <% if (schedule && schedule.daysOfWeek) { %>
                        <% schedule.daysOfWeek.forEach((day, index) => { %>
                            <label
                                class="day-pill<%= index === 0 ? ' selected' : '' %>"
                                for="day-<%= index %>"
                            >
                                <input
                                    type="radio"
                                    name="selectedDay"
                                    id="day-<%= index %>"
                                    value="<%= day %>"
                                    <%= index === 0 ? 'checked' : '' %>
                                    required
                                >
                                <span class="day-text"><%= day %></span>
                            </label>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </section>

        <section class="passengers-section">
            <div class="passengers-header">
                <h2 class="section-title">Passenger Details</h2>

                <button type="button" class="btn-add-passenger" id="addPassenger">
                    <span class="add-icon">+</span>
                    Add Passenger
                </button>
            </div>

            <div id="passengersList" class="passengers-list">
                <div class="passenger-card" data-passenger-index="0">
                    <div class="passenger-card-header">
                        <h3 class="passenger-number">Passenger 1</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="firstName-0" class="form-label">First Name</label>
                            <input
                                type="text"
                                id="firstName-0"
                                name="passengers[0][firstName]"
                                class="form-input"
                                required
                                placeholder="Enter first name"
                            >
                        </div>

                        <div class="form-group">
                            <label for="lastName-0" class="form-label">Last Name</label>
                            <input
                                type="text"
                                id="lastName-0"
                                name="passengers[0][lastName]"
                                class="form-input"
                                required
                                placeholder="Enter last name"
                            >
                        </div>

                        <div class="form-group">
                            <label for="email-0" class="form-label">Email Address</label>
                            <input
                                type="email"
                                id="email-0"
                                name="passengers[0][email]"
                                class="form-input"
                                required
                                placeholder="your.email@example.com"
                            >
                        </div>

                        <div class="form-group">
                            <label for="phone-0" class="form-label">Phone Number</label>
                            <input
                                type="tel"
                                id="phone-0"
                                name="passengers[0][phone]"
                                class="form-input"
                                required
                                placeholder="+81 90-1234-5678"
                            >
                        </div>
                    </div>
                </div>
            </div>

            <p class="passenger-limit-note">
                Maximum 8 passengers per online booking. Please call to schedule larger groups.
                (<a href="#" id="autofill">Click Here to Auto Fill Form</a>)
            </p>
        </section>

        <section class="booking-summary">
            <h2 class="section-title">Booking Summary</h2>

            <div class="summary-content">
                <div class="summary-row">
                    <span class="summary-label">Selected Ticket:</span>
                    <span class="summary-value" id="selectedTicketName">
                        Standard Class
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Number of Passengers:</span>
                    <span class="summary-value" id="passengerCount">1</span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Price per Ticket:</span>
                    <span class="summary-value" id="pricePerTicket">
                        ¥0
                    </span>
                </div>

                <div class="summary-row total">
                    <span class="summary-label">Total Amount:</span>
                    <span class="summary-value" id="totalAmount">
                        ¥0
                    </span>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <a href="/routes/<%= schedule.routeId %>" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Confirm Booking</button>
        </div>
    </form>
</article>

<script>
    const maxPassengers = 8;
    let passengerCount = 1;
    let ticketPrice = 0;

    const selectedDayLabels = document.querySelectorAll('.days-display label');
    const dayInputs = document.querySelectorAll('input[name="selectedDay"]');
    const passengersList = document.getElementById('passengersList');
    const addPassengerBtn = document.getElementById('addPassenger');

    const selectedTicketName = document.getElementById('selectedTicketName');
    const selectedTicketClassInput = document.getElementById('selectedTicketClass');
    const passengerCountDisplay = document.getElementById('passengerCount');
    const pricePerTicket = document.getElementById('pricePerTicket');
    const totalAmount = document.getElementById('totalAmount');

    const updateSummary = () => {
        passengerCountDisplay.textContent = passengerCount;
        pricePerTicket.textContent = `¥${ticketPrice.toLocaleString()}`;
        totalAmount.textContent = `¥${(ticketPrice * passengerCount).toLocaleString()}`;
    };

    const updatePassengerNumbers = () => {
        const cards = document.querySelectorAll('.passenger-card');

        cards.forEach((card, index) => {
            card.querySelector('.passenger-number').textContent = `Passenger ${index + 1}`;
        });
    };

    const createRemoveButton = () => {
        const btn = document.createElement('button');

        btn.type = 'button';
        btn.className = 'btn-remove-passenger';
        btn.innerHTML = '<span class="remove-icon">×</span>';
        btn.setAttribute('aria-label', 'Remove passenger');

        return btn;
    };

    const addPassenger = () => {
        if (passengerCount >= maxPassengers) {
            alert(`Maximum of ${maxPassengers} passengers allowed per booking`);
            return;
        }

        const index = passengerCount;

        const passengerCard = document.createElement('div');
        passengerCard.className = 'passenger-card';
        passengerCard.setAttribute('data-passenger-index', index);

        passengerCard.innerHTML = `
            <div class="passenger-card-header">
                <h3 class="passenger-number">Passenger ${index + 1}</h3>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label for="firstName-${index}" class="form-label">First Name</label>
                    <input
                        type="text"
                        id="firstName-${index}"
                        name="passengers[${index}][firstName]"
                        class="form-input"
                        required
                        placeholder="Enter first name"
                    >
                </div>

                <div class="form-group">
                    <label for="lastName-${index}" class="form-label">Last Name</label>
                    <input
                        type="text"
                        id="lastName-${index}"
                        name="passengers[${index}][lastName]"
                        class="form-input"
                        required
                        placeholder="Enter last name"
                    >
                </div>

                <div class="form-group">
                    <label for="email-${index}" class="form-label">Email Address</label>
                    <input
                        type="email"
                        id="email-${index}"
                        name="passengers[${index}][email]"
                        class="form-input"
                        required
                        placeholder="your.email@example.com"
                    >
                </div>

                <div class="form-group">
                    <label for="phone-${index}" class="form-label">Phone Number</label>
                    <input
                        type="tel"
                        id="phone-${index}"
                        name="passengers[${index}][phone]"
                        class="form-input"
                        required
                        placeholder="+81 90-1234-5678"
                    >
                </div>
            </div>
        `;

        const removeBtn = createRemoveButton();

        passengerCard
            .querySelector('.passenger-card-header')
            .appendChild(removeBtn);

        passengersList.appendChild(passengerCard);

        passengerCount++;

        updateSummary();
        updateAddButtonState();
        addRemoveAllButtons();
    };

    const removePassenger = (card) => {
        if (passengerCount <= 1) {
            alert('At least one passenger is required');
            return;
        }

        card.remove();
        passengerCount--;

        updatePassengerNumbers();
        updateSummary();
        updateAddButtonState();
        addRemoveAllButtons();
    };

    const updateAddButtonState = () => {
        addPassengerBtn.disabled = passengerCount >= maxPassengers;

        if (passengerCount >= maxPassengers) {
            addPassengerBtn.classList.add('disabled');
        } else {
            addPassengerBtn.classList.remove('disabled');
        }
    };

    const addRemoveAllButtons = () => {
        const firstCard = document.querySelector('.passenger-card');

        if (!firstCard) {
            return;
        }

        const existingBtn = firstCard.querySelector('.btn-remove-passenger');

        if (passengerCount > 1 && !existingBtn) {
            const removeBtn = createRemoveButton();

            firstCard
                .querySelector('.passenger-card-header')
                .appendChild(removeBtn);
        }

        if (passengerCount === 1 && existingBtn) {
            existingBtn.remove();
        }
    };

    let currentTicketPage = 1;
    const ticketPageSize = 10;
    let selectedTicket = null;

    const ticketOptionsContainer =
        document.getElementById('ticketOptions');

    const ticketPagination =
        document.getElementById('ticketPagination');

    const renderTicketCards = (ticketClasses) => {
        ticketOptionsContainer.innerHTML = '';

        if (!ticketClasses.length) {
            const emptyMessage = document.createElement('p');
            emptyMessage.className = 'ticket-empty';
            emptyMessage.textContent = 'No ticket classes available.';
            ticketOptionsContainer.appendChild(emptyMessage);
            return;
        }

        ticketClasses.forEach((ticket, index) => {
            const label = document.createElement('label');
            label.className = 'ticket-card';
            label.setAttribute('data-ticket-class', ticket.class);

            const radio = document.createElement('input');
            radio.type = 'radio';
            radio.name = 'ticketChoice';
            radio.value = ticket.class;
            radio.dataset.name = ticket.name;
            radio.dataset.price = ticket.pricePerKm;
            radio.checked =
                selectedTicket === ticket.class ||
                (!selectedTicket && index === 0);
            radio.required = true;

            const cardContent = document.createElement('div');
            cardContent.className = 'ticket-content';

            const cardHeader = document.createElement('div');
            cardHeader.className = 'ticket-header';

            const ticketName = document.createElement('h3');
            ticketName.className = 'ticket-name';
            ticketName.textContent = ticket.name;

            const ticketPriceElement = document.createElement('div');
            ticketPriceElement.className = 'ticket-price';

            const priceSymbol = document.createElement('span');
            priceSymbol.className = 'price-symbol';
            priceSymbol.textContent = '\u00A5';

            const priceAmount = document.createElement('span');
            priceAmount.className = 'price-amount';
            priceAmount.textContent =
                Number(ticket.pricePerKm).toLocaleString();

            ticketPriceElement.appendChild(priceSymbol);
            ticketPriceElement.appendChild(priceAmount);

            cardHeader.appendChild(ticketName);
            cardHeader.appendChild(ticketPriceElement);

            const ticketDescription = document.createElement('p');
            ticketDescription.className = 'ticket-description';
            ticketDescription.textContent = ticket.description || '';

            cardContent.appendChild(cardHeader);
            cardContent.appendChild(ticketDescription);

            if (ticket.amenities?.length) {
                const amenitiesList = document.createElement('ul');
                amenitiesList.className = 'amenities-list';

                ticket.amenities.forEach((amenity) => {
                    const amenityItem = document.createElement('li');
                    amenityItem.className = 'amenity-item';

                    const amenityIcon = document.createElement('span');
                    amenityIcon.className = 'amenity-icon';
                    amenityIcon.textContent = '\u2713';
                    amenityIcon.setAttribute('aria-hidden', 'true');

                    const amenityText = document.createElement('span');
                    amenityText.className = 'amenity-text';
                    amenityText.textContent = amenity;

                    amenityItem.appendChild(amenityIcon);
                    amenityItem.appendChild(amenityText);
                    amenitiesList.appendChild(amenityItem);
                });

                cardContent.appendChild(amenitiesList);
            }

            label.appendChild(radio);
            label.appendChild(cardContent);
            ticketOptionsContainer.appendChild(label);
        });

        const selectedRadio = ticketOptionsContainer.querySelector(
            'input[name="ticketChoice"]:checked'
        );

        if (selectedRadio) {
            updateSelectedTicket(selectedRadio);
        }

        ticketOptionsContainer
            .querySelectorAll('input[name="ticketChoice"]')
            .forEach((radio) => {
                radio.addEventListener('change', () => {
                    if (!radio.disabled) {
                        updateSelectedTicket(radio);
                    }
                });
            });
    };

    const renderTicketPagination = (metadata) => {
        ticketPagination.innerHTML = '';

        if (metadata.totalPages <= 1) {
            return;
        }

        const previousButton = document.createElement('button');
        previousButton.type = 'button';
        previousButton.className = 'btn btn-secondary';
        previousButton.textContent = 'Previous';
        previousButton.disabled = metadata.page <= 1;

        previousButton.addEventListener('click', () => {
            if (currentTicketPage > 1) {
                currentTicketPage -= 1;
                loadTicketClasses(currentTicketPage);
            }
        });

        const pageInfo = document.createElement('span');
        pageInfo.className = 'ticket-page-info';
        pageInfo.textContent =
            `Page ${metadata.page} of ${metadata.totalPages}`;

        const nextButton = document.createElement('button');
        nextButton.type = 'button';
        nextButton.className = 'btn btn-secondary';
        nextButton.textContent = 'Next';
        nextButton.disabled =
            metadata.page >= metadata.totalPages;

        nextButton.addEventListener('click', () => {
            if (currentTicketPage < metadata.totalPages) {
                currentTicketPage += 1;
                loadTicketClasses(currentTicketPage);
            }
        });

        ticketPagination.appendChild(previousButton);
        ticketPagination.appendChild(pageInfo);
        ticketPagination.appendChild(nextButton);
    };

    const loadTicketClasses = async (page = 1) => {
        try {
            ticketOptionsContainer.innerHTML =
                '<p class="ticket-loading">Loading ticket classes...</p>';

            const response = await fetch(
                `/api/ticket-classes?page=${page}&limit=${ticketPageSize}`
            );

            if (!response.ok) {
                throw new Error('Failed to fetch ticket classes');
            }

            const result = await response.json();

            currentTicketPage = result.metadata.page;

            renderTicketCards(result.data);
            renderTicketPagination(result.metadata);

            const selectedDay = document.querySelector(
                'input[name="selectedDay"]:checked'
            );

            if (selectedDay) {
                await updateTicketAvailability(selectedDay.value);
            }
        } catch (error) {
            console.error('Error loading ticket classes:', error);

            ticketOptionsContainer.innerHTML =
                '<p class="ticket-error">Unable to load ticket classes.</p>';

            ticketPagination.innerHTML = '';
        }
    };
    const updateTicketAvailability = async (day) => {
        try {
            const response = await fetch(
                `/api/ticket-classes?day=${encodeURIComponent(day)}`
            );

            if (!response.ok) {
                throw new Error('Failed to fetch ticket classes');
            }

            const result = await response.json();
            const availableClasses = result.data;

            const availableClassNames = new Set(
                availableClasses.map(ticket => ticket.class)
            );

            const ticketRadios = document.querySelectorAll(
                'input[name="ticketChoice"]'
            );

            ticketRadios.forEach((radio) => {
                const ticketCard = radio.closest('.ticket-card');
                const isAvailable = availableClassNames.has(radio.value);

                radio.disabled = !isAvailable;

                if (ticketCard) {
                    ticketCard.classList.toggle('disabled', !isAvailable);
                    ticketCard.setAttribute(
                        'aria-disabled',
                        String(!isAvailable)
                    );
                }

                if (!isAvailable) {
                    radio.checked = false;
                }
            });

            if (
                selectedTicket &&
                availableClassNames.has(selectedTicket)
            ) {
                const selectedRadio = [...ticketRadios].find(
                    radio => radio.value === selectedTicket
                );

                if (selectedRadio) {
                    selectedRadio.checked = true;
                }

                selectedTicketClassInput.value = selectedTicket;
                return;
            }

            const firstAvailable = [...ticketRadios].find(
                radio => !radio.disabled
            );

            if (firstAvailable) {
                firstAvailable.checked = true;
                updateSelectedTicket(firstAvailable);
            }
        } catch (error) {
            console.error('Error loading ticket classes:', error);
        }
    };
    const updateSelectedTicket = (radio) => {
        const ticketName = radio.dataset.name;
        selectedTicket = radio.value;
        selectedTicketClassInput.value = selectedTicket;
        ticketPrice = Number(radio.dataset.price);

        selectedTicketName.textContent = ticketName;

        updateSummary();
    };

    const autoFillForm = () => {
        const westernFirstNames = [
            'James',
            'Olivia',
            'William',
            'Emily',
            'Charlotte',
            'George',
            'Anna',
            'Henry'
        ];

        const westernLastNames = [
            'Smith',
            'Johnson',
            'Brown',
            'Taylor',
            'Wilson',
            'Evans',
            'Clark',
            'Davis'
        ];

        const japaneseFirstNames = [
            'Yuki',
            'Haruto',
            'Sakura',
            'Akira',
            'Hana',
            'Kenji',
            'Aoi',
            'Takeshi'
        ];

        const japaneseLastNames = [
            'Tanaka',
            'Suzuki',
            'Yamamoto',
            'Watanabe',
            'Ito',
            'Nakamura',
            'Kobayashi',
            'Sato'
        ];

        const randomItem = (array) =>
            array[Math.floor(Math.random() * array.length)];

        const randInt = (min, max) =>
            Math.floor(Math.random() * (max - min + 1)) + min;

        const cards = document.querySelectorAll('.passenger-card');

        cards.forEach((card, index) => {
            const i = card.dataset.passengerIndex
                ? Number(card.dataset.passengerIndex)
                : index;

            const isJapanese = Math.random() < 0.30;

            const firstName = randomItem(
                isJapanese ? japaneseFirstNames : westernFirstNames
            );

            const lastName = randomItem(
                isJapanese ? japaneseLastNames : westernLastNames
            );

            const firstNameInput = card.querySelector(`#firstName-${i}`);
            const lastNameInput = card.querySelector(`#lastName-${i}`);
            const emailInput = card.querySelector(`#email-${i}`);
            const phoneInput = card.querySelector(`#phone-${i}`);

            if (firstNameInput) {
                firstNameInput.value = firstName;
            }

            if (lastNameInput) {
                lastNameInput.value = lastName;
            }

            if (emailInput) {
                emailInput.value =
                    `${firstName.toLowerCase()}.${lastName.toLowerCase()}${randInt(10, 99)}@example.com`;
            }

            if (phoneInput) {
                if (isJapanese) {
                    phoneInput.value =
                        `+81 120-${randInt(100, 999)}-${randInt(1000, 9999)}`;
                } else if (Math.random() < 0.5) {
                    phoneInput.value =
                        `+1 555-01${String(randInt(10, 99)).padStart(2, '0')}-${randInt(1000, 9999)}`;
                } else {
                    phoneInput.value =
                        `+44 1632 960${String(randInt(100, 999))}`;
                }
            }
        });
    };

    selectedDayLabels.forEach((label) => {
        label.addEventListener('click', (event) => {
            event.preventDefault();

            const input = label.querySelector('input');

            selectedDayLabels.forEach((currentLabel) => {
                currentLabel.classList.remove('selected');

                const currentInput = currentLabel.querySelector('input');

                currentInput.checked = false;
            });

            label.classList.add('selected');
            input.checked = true;

            updateTicketAvailability(input.value);
        });
    });

    dayInputs.forEach((input) => {
        input.addEventListener('change', () => {
            selectedDayLabels.forEach((label) => {
                label.classList.toggle(
                    'selected',
                    label.querySelector('input') === input
                );
            });

            updateTicketAvailability(input.value);
        });
    });

    addPassengerBtn.addEventListener('click', addPassenger);

    passengersList.addEventListener('click', (event) => {
        const removeBtn = event.target.closest('.btn-remove-passenger');

        if (removeBtn) {
            const card = removeBtn.closest('.passenger-card');
            removePassenger(card);
        }
    });

    document.getElementById('autofill').addEventListener('click', (event) => {
        event.preventDefault();
        autoFillForm();
    });

    loadTicketClasses(1);

    updateAddButtonState();
    updateSummary();
</script>

<%- include('../partials/footer') %>
